# Copy to .env (gitignored) for local `netlify dev` testing of netlify/functions/chat.ts.
# Set the real key in Netlify's dashboard (Site configuration -> Environment variables) for production —
# never prefix with VITE_, or Vite will inline it into the client bundle.
ANTHROPIC_API_KEY=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXX). Unlike ANTHROPIC_API_KEY
# above, this is NOT a secret — it's meant to be visible in every page's
# outgoing network requests, so the VITE_ prefix (which inlines it into the
# client bundle) is correct and intentional here. Set the same value in
# Netlify's dashboard for production — Vite substitutes it into index.html's
# %VITE_GA_MEASUREMENT_ID% placeholders at build time, so it must be set
# before a deploy, not just added afterward.
VITE_GA_MEASUREMENT_ID=
